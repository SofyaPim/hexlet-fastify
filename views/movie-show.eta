<% layout("./layouts/page.eta") %>

<h2>Больше о фильме</h2>
<div style="border: 1px solid #ccc; padding: 15px; border-radius: 5px; max-width: 400px; margin-bottom: 15px;">
  <h3><%= it.movie.title %></h3>
  <p><strong>Год премьеры:</strong> <%= it.movie.year %></p>
  <p><strong>Кассовые сборы:</strong> <span style="color: green; font-weight: bold;"><%= it.movie.boxOffice %></span></p>
</div>

<p><a href="/movies">← Назад к списку фильмов</a></p>
