<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Eta</title>
   <style>
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f7f5f0;
      color: #333;
      margin: 0;
      padding: 20px;
      line-height: 1.6;
    }

   
    .container {
      max-width: 900px;
      margin: 0 auto;
      background: #ffffff;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

   
    .nav-menu {
      display: flex;
      gap: 15px;
      margin-bottom: 30px;
      padding-bottom: 15px;
      border-bottom: 2px solid #4a154b;
    }

   
    a {
      color: #4a154b;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s ease;
    }
    a:hover {
      color: #6f2b70;
      text-decoration: underline;
    }

   
    .btn-primary, button[type="submit"] {
      display: inline-block;
      background-color: #4a154b;
      color: white !important;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
      font-size: 14px;
      transition: background-color 0.2s ease;
    }
    .btn-primary:hover, button[type="submit"]:hover {
      background-color: #6f2b70;
      text-decoration: none;
    }

     .btn-secondary {
      display: inline-block;
      background-color: transparent;
      color: #4a154b !important;
      border: 1px solid #4a154b;
      padding: 9px 19px;
      border-radius: 5px;
      font-weight: bold;
      text-decoration: none;
      font-size: 14px;
      transition: all 0.2s ease;
    }
    .btn-secondary:hover {
      background-color: #f5edf6;
      text-decoration: none;
    }

   
    .btn-danger {
      background-color: #a32a2a;
      color: white;
      padding: 6px 12px;
      border: none;
      border-radius: 4px;
      font-weight: bold;
      cursor: pointer;
    }
    .btn-danger:hover {
      background-color: #bd3a3a;
    }

   
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    
    .card {
      border: 1px solid #e0e0e0;
      padding: 20px;
      border-radius: 6px;
      background: #fdfbf7;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 15px;
    }
    .card h4, .card h3 {
      margin: 0 0 10px 0;
      color: #4a154b;
    }

   
    .alert-success {
      background: #e6f4ea;
      color: #137333;
      padding: 12px;
      border-radius: 4px;
      margin-bottom: 20px;
    }
    .alert-warning {
      background: #fce8e6;
      color: #c5221f;
      padding: 12px;
      border-radius: 4px;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
 <div class="container">
  <header> 

    <h1>Лейауты в Eta</h1>
    <h2>КиноПортал на Eta</h2>
    <nav>
     <ul style="display: flex; gap: 15px; list-style: none; padding: 0;">
        <li><a href="/">Мультфильмы</a></li>
        <!-- Старые ссылки работают через it.reverse -->
        <li><a href="<%= it.reverse('movies') %>">🎬 Фильмы</a></li>
        <li><a href="/series">🎬🎬Сериалы</a></li>
        <li><a href="<%= it.reverse('courses') %>">🔮 Курсы Хогвартса</a></li>
        <li><a href="/users">👥Пользователи</a></li>
      </ul>


      <div style="margin-top: 15px; padding: 10px; border-top: 1px solid #ccc;">
        <% if (it.username) { %>
          <div style="color: #155724; margin-bottom: 5px;">Вы вошли как: <strong><%= it.username %></strong></div>
          <form action="<%= it.route('deleteSession') %>" method="POST" style="display: inline;">
            <button type="submit" style="padding: 4px 10px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">Выйти</button>
          </form>
        <% } else { %>
          <div style="color: #856404; margin-bottom: 5px;">Вы зашли как гость</div>
          <a href="<%= it.route('newSession') %>" style="display: inline-block; padding: 5px 12px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;">Войти в систему</a>
        <% } %>
      </div>


    </nav>
    <% if (it.flash && it.flash.length > 0) { %>
    <div style="margin: 15px 20px;">
      <% it.flash.forEach((message) => { %>
        <div style="padding: 10px; margin-bottom: 10px; border-radius: 4px; font-family: sans-serif;
          background-color: <%= message.type === 'success' ? '#d4edda' : '#fff3cd' %>;
          color: <%= message.type === 'success' ? '#155724' : '#856404' %>;
          border: 1px solid <%= message.type === 'success' ? '#c3e6cb' : '#ffeeba' %>;">          
          <%= message.message %>          
        </div>
      <% }) %>
    </div>
  <% } %>
  </header>

  
  <main>
    <%~ it.body %>
  </main>

  <footer>
    <a href="https://github.com/SofyaPim/hexlet-fastify">SofyaPim/hexlet-fastify</a>
    <% if (!it.visited) { %>
      <div class="alert alert-info" style="margin-top: 10px; background: #e2f0d9; padding: 5px;">
        Это сообщение показывается только один раз. Если вы хотите увидеть его снова, сотрите куки.
      </div>
    <% } %>
  </footer>
  </div>
</body>
</html>
