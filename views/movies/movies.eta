<% layout("../layouts/page.eta") %>

<h2><%= it.title %></h2> 

<ol>
  <% it.movies.forEach((movie) => { %>
    <li>
     
      <a  href="<%= it.reverse('movieShow', { id: movie.id }) %>">
      <strong><%= movie.title %></strong>
      </a> 
   
    </li>
  <% }) %>
</ol>
<a href="<%= it.reverse('newMovie') %>">Добавить новый фильм</a>




<p><a href="/">← На главную</a></p>
