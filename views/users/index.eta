<% layout("../layouts/page") %>

<h2>Список зарегистрированных пользователей</h2>
<ul>
  <% it.users.forEach((user) => { %>
    <li>
      <strong><%= user.username %></strong> — <%= user.email %> 
      (<a href="<%= it.reverse('userShow', { id: user.id }) %>">Профиль</a>)

    </li>
  <% }) %>
</ul>

<p><a href="/users/new">Зарегистрировать еще одного</a></p>
